<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.chinashb.www.mobileerp.widget.TitleLayoutManagerView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:app_title_text="来料待入拣货" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/et_pending_picking_keyword"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="搜索型号、物料或供应商"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_pending_picking_search"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="搜索" />

        <Button
            android:id="@+id/btn_pending_picking_refresh"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="刷新" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_pending_enter_scan_in"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:text="进入扫描入库页面" />

    <TextView
        android:id="@+id/tv_pending_picking_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:text="共 0 件"
        android:textColor="#555555"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/pb_pending_picking_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <com.chinashb.www.mobileerp.widget.CustomRecyclerView
        android:id="@+id/rv_pending_warehouse_picking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        app:app_item_decoration_type="ITEM_SPACE"
        app:app_layout_style="list_vertical"
        tools:listitem="@layout/item_pending_warehouse_picking" />

</LinearLayout>
