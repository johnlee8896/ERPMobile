<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:orientation="vertical">
    <!-- codex by john 2026-09-04 16:01 - 不用通用标题栏，改为自定义标题栏，避免标题文字与右侧按钮重叠 -->
    <LinearLayout
        android:id="@+id/mw_backup_title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_size_50"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mw_backup_title_back"
            android:layout_width="@dimen/dimen_size_50"
            android:layout_height="match_parent"
            android:background="@drawable/selector_item_click_bg_gray"
            android:scaleType="center"
            android:src="@mipmap/ic_back_dark" />

        <TextView
            android:id="@+id/mw_backup_title_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="备料管理页面"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_17" />

        <Button
            android:id="@+id/mw_backup_title_select_all_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginRight="@dimen/dimen_size_5"
            android:background="@drawable/shape_conner_blue_button_bg"
            android:text="全选"
            android:textSize="15sp" />

        <Button
            android:id="@+id/mw_backup_extra_out_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginRight="@dimen/dimen_size_5"
            android:background="@drawable/shape_conner_blue_button_bg"
            android:text="额外出库"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/mw_backup_title_confirm_Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginRight="@dimen/dimen_size_10"
            android:background="@drawable/shape_conner_blue_button_bg"
            android:text="一键出库"
            android:textSize="15sp" />

    </LinearLayout>
    <com.chinashb.www.mobileerp.widget.CustomRecyclerView
        android:id="@+id/mw_backup_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        app:app_item_decoration_type="ITEM_SPACE"
        app:app_layout_style="list_vertical"
        tools:itemCount="10"
        tools:listitem="@layout/item_goods_order_list_layout" />

    <com.chinashb.www.mobileerp.widget.EmptyLayoutManageView
        android:id="@+id/mw_backup_empty_layoutView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />




</LinearLayout>
