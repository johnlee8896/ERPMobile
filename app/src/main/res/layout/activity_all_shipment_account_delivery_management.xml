<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <com.chinashb.www.mobileerp.widget.TitleLayoutManagerView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:app_title_text="外贸发运扫码管理" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/shipment_attach_shipment_container_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="发运单装集装箱"
            android:textSize="12sp" />

        <Button
            android:id="@+id/shipment_detach_shipment_container_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="发运单移出集装箱"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/shipment_attach_container_pallet_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="集装箱装托盘"
            android:textSize="12sp" />

        <Button
            android:id="@+id/shipment_detach_container_pallet_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="集装箱移出托盘"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/shipment_add_pallet_item_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="托盘装物料"
            android:textSize="12sp" />

        <Button
            android:id="@+id/shipment_remove_pallet_item_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="托盘移出物料"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/shipment_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:lineSpacingExtra="2dp"
        android:minHeight="92dp"
        android:padding="10dp"
        android:text="当前模式：发运单装集装箱"
        android:textColor="#222222"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/shipment_input_edit"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:hint="请扫描条码"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/shipment_camera_scan_button"
            android:layout_width="72dp"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            android:text="相机" />
    </LinearLayout>

    <com.chinashb.www.mobileerp.widget.CustomRecyclerView
        android:id="@+id/shipment_scan_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        app:app_item_decoration_type="ITEM_SPACE"
        app:app_item_margin="6dp"
        app:app_layout_style="list_vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/shipment_toggle_pallet_check_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="封箱当前托盘" />

        <Button
            android:id="@+id/shipment_reset_target_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="重置当前目标" />

        <Button
            android:id="@+id/shipment_clear_records_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="清空当前模式记录" />
    </LinearLayout>

</LinearLayout>
