<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/background_light"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/background_light"
        android:orientation="vertical">
        <com.chinashb.www.mobileerp.widget.TitleLayoutManagerView
            android:layout_width="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:app_title_text="成品手工标签操作"
            android:layout_height="50dp"/>



        <TextView
            android:id="@+id/product_main_manu_code_box_code_check_pallet_textView"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="@dimen/dimen_size_20"
            android:layout_marginTop="@dimen/dimen_size_50"
            android:layout_marginRight="@dimen/dimen_size_20"
            android:background="@drawable/shape_conner_blue_button_bg"
            android:gravity="center"
            android:text="手工标签(托盘)盘点" />

        <TextView
            android:id="@+id/product_main_manu_code_box_code_check_Not_Pallet_textView"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="@dimen/dimen_size_20"
            android:layout_marginTop="@dimen/dimen_size_15"
            android:layout_marginRight="@dimen/dimen_size_20"
            android:background="@drawable/shape_conner_blue_button_bg"
            android:gravity="center"
            android:text="手工标签(非托盘)盘点" />




        <TextView
            android:id="@+id/product_main_manu_code_box_move_pallet_textView"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="@dimen/dimen_size_20"
            android:layout_marginTop="@dimen/dimen_size_15"
            android:layout_marginRight="@dimen/dimen_size_20"
            android:background="@drawable/shape_conner_blue_button_bg"
            android:gravity="center"
            android:text="手工标签(托盘)移库" />

        <TextView
            android:id="@+id/product_main_manu_code_box_move_not_pallet_textView"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="@dimen/dimen_size_20"
            android:layout_marginTop="@dimen/dimen_size_15"
            android:layout_marginRight="@dimen/dimen_size_20"
            android:background="@drawable/shape_conner_blue_button_bg"
            android:gravity="center"
            android:text="手工标签(非托盘)移库" />




    </LinearLayout>

</android.support.v4.widget.NestedScrollView>
