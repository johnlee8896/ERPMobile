<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/background_light"
    android:orientation="vertical">

    <com.chinashb.www.mobileerp.widget.TitleLayoutManagerView
        android:id="@+id/product_ship_work_post_title_layout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:app_title_text="发运确认" />

    <TextView
        android:id="@+id/product_ship_work_post_summary_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_20"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_15" />

    <CheckBox
        android:id="@+id/product_ship_work_post_confirm_checkBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_14"
        android:text="已核对本车托盘、OQC结果和物流单" />

    <Button
        android:id="@+id/product_ship_work_post_return_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_14"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:text="撤回托盘（OQC失效）" />

    <Button
        android:id="@+id/product_ship_work_post_submit_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_10"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:text="销售出库记账" />

    <TextView
        android:id="@+id/product_ship_work_post_status_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_10"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:gravity="center"
        android:textColor="@color/color_orange_FF6A00"
        android:textSize="@dimen/text_size_15" />

</LinearLayout>
