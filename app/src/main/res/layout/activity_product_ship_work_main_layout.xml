<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/background_light"
    android:orientation="vertical">

    <com.chinashb.www.mobileerp.widget.TitleLayoutManagerView
        android:id="@+id/product_ship_work_title_layout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:app_title_text="成品发货管理" />

    <TextView
        android:id="@+id/product_ship_work_operator_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_15"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:text="操作员："
        android:textSize="@dimen/text_size_14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_15"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:orientation="horizontal">

        <Button
            android:id="@+id/product_ship_work_create_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="新建发货作业" />

        <Button
            android:id="@+id/product_ship_work_continue_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="刷新任务" />
    </LinearLayout>

    <TextView
        android:id="@+id/product_ship_work_active_title_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_15"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:text="执行中的发货作业"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/product_ship_work_status_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_6"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:textColor="@color/color_orange_FF6A00"
        android:textSize="@dimen/text_size_14" />

    <com.chinashb.www.mobileerp.widget.CustomRecyclerView
        android:id="@+id/product_ship_work_active_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginRight="@dimen/dimen_size_20"
        app:app_layout_style="list_vertical" />

</LinearLayout>
