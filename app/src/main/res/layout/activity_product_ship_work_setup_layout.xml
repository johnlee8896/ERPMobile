<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/background_light"
    android:orientation="vertical">

    <com.chinashb.www.mobileerp.widget.TitleLayoutManagerView
        android:id="@+id/product_ship_work_setup_title_layout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:app_title_text="作业设置" />

    <TextView
        android:id="@+id/product_ship_work_setup_do_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_10"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:textColor="@color/login_title_color"
        android:textSize="@dimen/text_size_15"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/product_ship_work_setup_warehouse_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_6"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:text="仓库：正在读取"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:layout_marginTop="@dimen/dimen_size_10"
        android:layout_marginRight="@dimen/dimen_size_10"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/product_ship_work_setup_delivery_textView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="物流单：未选择"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_14" />

        <Button
            android:id="@+id/product_ship_work_new_delivery_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="新建物流单" />
    </LinearLayout>

    <TextView
        android:id="@+id/product_ship_work_setup_delivery_title_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_8"
        android:text="选择物流单"
        android:textColor="@color/color_orange_FF6A00"
        android:textStyle="bold" />

    <com.chinashb.www.mobileerp.widget.CustomRecyclerView
        android:id="@+id/product_ship_work_setup_delivery_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="@dimen/dimen_size_6"
        app:app_layout_style="list_vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:layout_marginTop="@dimen/dimen_size_10"
        android:layout_marginRight="@dimen/dimen_size_10"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/product_ship_work_setup_stage_textView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="发货区：未设置"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_14" />

        <Button
            android:id="@+id/product_ship_work_setup_stage_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置发货区" />
    </LinearLayout>

    <Button
        android:id="@+id/product_ship_work_setup_create_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_20"
        android:layout_marginTop="@dimen/dimen_size_14"
        android:layout_marginRight="@dimen/dimen_size_20"
        android:text="建立发货作业" />

</LinearLayout>
