<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.chinashb.www.mobileerp.widget.TitleLayoutManagerView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:app_title_text="物料使用线别查询" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/et_item_usage_item_id"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="输入 Item_ID"
            android:imeOptions="actionSearch"
            android:inputType="number"
            android:maxLines="1"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_item_usage_search"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="查询" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_item_usage_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:text="共 0 行"
        android:textColor="#555555"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/pb_item_usage_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <com.chinashb.www.mobileerp.widget.CustomRecyclerView
        android:id="@+id/rv_item_usage_line"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        app:app_item_decoration_type="ITEM_SPACE"
        app:app_layout_style="list_vertical"
        tools:listitem="@layout/item_item_usage_line_query" />

</LinearLayout>
