<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:layout_margin="@dimen/dimen_size_10"
    android:padding="@dimen/dimen_size_10"
    android:orientation="vertical">
    <!-- 新增CheckBox，放置在每项信息的最左侧 -->
<!--        android:layout_marginEnd="@dimen/dimen_size_10"-->
    <CheckBox
        android:id="@+id/item_common_item_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


<!--        app:constraint_referenced_ids="ite∂m_common_first_info_textView,item_second_info_textView,item_third_info_textView,item_fourth_info_textView,item_fifth_info_textView"-->
    <android.support.constraint.Barrier
        android:id="@+id/item_common_barrier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="item_common_item_checkbox,item_common_first_info_textView,item_second_info_textView,item_third_info_textView,item_fourth_info_textView,item_fifth_info_textView"
        app:barrierDirection="right"
        app:layout_constraintLeft_toLeftOf="parent" />
    <TextView
        android:id="@+id/item_common_first_info_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="大区:"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_15"
        app:layout_constraintStart_toEndOf="@id/item_common_item_checkbox"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_first_name_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="上海胜华波汽车电器有限公司"
        android:textColor="@color/login_title_color"
        app:layout_constraintLeft_toRightOf="@id/item_common_barrier"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_second_info_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:paddingTop="@dimen/dimen_size_10"
        tools:text="存储单元:"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_15"
        app:layout_constraintStart_toStartOf="@id/item_common_first_info_textView"
        app:layout_constraintTop_toBottomOf="@id/item_common_first_info_textView" />

    <TextView
        android:id="@+id/item_second_name_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="有限公司"
        android:textColor="@color/black"
        app:layout_constraintLeft_toRightOf="@id/item_common_barrier"
        app:layout_constraintTop_toBottomOf="@id/item_second_info_textView"
        app:layout_constraintTop_toTopOf="@id/item_second_info_textView" />


    <TextView
        android:id="@+id/item_third_info_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:paddingTop="@dimen/dimen_size_10"
        tools:text="批次号: "
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_15"
        app:layout_constraintStart_toStartOf="@id/item_second_info_textView"
        app:layout_constraintStart_toEndOf="@id/item_common_item_checkbox"

        app:layout_constraintTop_toBottomOf="@id/item_second_info_textView" />

    <TextView
        android:id="@+id/item_third_name_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="1"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/item_third_info_textView"
        app:layout_constraintLeft_toRightOf="@id/item_common_barrier"
        app:layout_constraintTop_toTopOf="@id/item_third_info_textView" />

    <TextView
        android:id="@+id/item_fourth_info_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="Item_ID: "
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_15"
        app:layout_constraintStart_toStartOf="@id/item_third_info_textView"
        app:layout_constraintStart_toEndOf="@id/item_common_item_checkbox"

        app:layout_constraintTop_toBottomOf="@id/item_third_info_textView" />

    <TextView
        android:id="@+id/item_fourth_name_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="钣金车间"
        app:layout_constraintBottom_toBottomOf="@id/item_fourth_info_textView"
        app:layout_constraintLeft_toRightOf="@id/item_common_barrier"
        app:layout_constraintTop_toTopOf="@id/item_fourth_info_textView" />

    <TextView
        android:id="@+id/item_fifth_info_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="规格型号: "
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_15"
        app:layout_constraintStart_toStartOf="@id/item_fourth_info_textView"
        app:layout_constraintStart_toEndOf="@id/item_common_item_checkbox"
        app:layout_constraintTop_toBottomOf="@id/item_fourth_info_textView" />
    <TextView
        android:id="@+id/item_fifth_name_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="钣金车间"
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/color_orange_FF6A00"
        app:layout_constraintBottom_toBottomOf="@id/item_fifth_info_textView"
        app:layout_constraintLeft_toRightOf="@id/item_common_barrier"
        app:layout_constraintTop_toTopOf="@id/item_fifth_info_textView" />

    <TextView
        android:id="@+id/item_sixth_info_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="物料名称: "
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_15"
        app:layout_constraintStart_toStartOf="@id/item_fifth_info_textView"
        app:layout_constraintStart_toEndOf="@id/item_common_item_checkbox"
        app:layout_constraintTop_toBottomOf="@id/item_fifth_info_textView" />

    <TextView
        android:id="@+id/item_sixth_name_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="电枢骨架"
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/color_orange_FF6A00"
        app:layout_constraintBottom_toBottomOf="@id/item_sixth_info_textView"
        app:layout_constraintLeft_toRightOf="@id/item_common_barrier"
        app:layout_constraintTop_toTopOf="@id/item_sixth_info_textView" />

    <TextView
        android:id="@+id/item_seventh_info_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="数量: "
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_15"
        app:layout_constraintStart_toStartOf="@id/item_sixth_info_textView"
        app:layout_constraintStart_toEndOf="@id/item_common_item_checkbox"
        app:layout_constraintTop_toBottomOf="@id/item_sixth_info_textView" />

    <TextView
        android:id="@+id/item_seventh_name_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:paddingTop="@dimen/dimen_size_10"
        tools:text="120"
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/color_orange_FF6A00"
        app:layout_constraintBottom_toBottomOf="@id/item_seventh_info_textView"
        app:layout_constraintLeft_toRightOf="@id/item_common_barrier"
        app:layout_constraintTop_toTopOf="@id/item_seventh_info_textView" />
    <!-- 新增：底部右侧操作按钮 -->
    <Button
        android:id="@+id/item_common_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="撤回备料"
        android:paddingStart="@dimen/dimen_size_12"
        android:paddingEnd="@dimen/dimen_size_12"
        android:paddingTop="@dimen/dimen_size_6"
        android:paddingBottom="@dimen/dimen_size_6"
        android:background="@drawable/shape_conner_blue_button_bg"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_14"
        android:layout_marginBottom="@dimen/dimen_size_10"
        android:layout_marginEnd="@dimen/dimen_size_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginRight="@dimen/dimen_size_10" />

</android.support.constraint.ConstraintLayout>