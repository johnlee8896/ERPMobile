<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/white"
    android:layout_marginLeft="@dimen/dimen_size_10"
    android:layout_marginRight="@dimen/dimen_size_10"
    android:layout_marginTop="@dimen/dimen_size_6"
    android:padding="@dimen/dimen_size_10">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_ship_work_order_customer_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/login_title_color"
            android:textSize="@dimen/text_size_15"
            android:textStyle="bold"
            tools:text="客户名称" />

        <TextView
            android:id="@+id/item_ship_work_order_track_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_14"
            tools:text="单号 GN20250101-7" />

        <TextView
            android:id="@+id/item_ship_work_order_do_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_14"
            tools:text="指令号 170633" />

    </LinearLayout>

    <ImageView
        android:id="@+id/item_ship_work_order_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:contentDescription="展开/收起"
        tools:src="@drawable/expander_ic_mini_collapsed" />

</LinearLayout>
