<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="false">
        <shape android:dither="true" android:shape="rectangle" android:visible="false">
            <corners android:bottomLeftRadius="10dp" android:bottomRightRadius="10dp" android:radius="10dp" android:topLeftRadius="10dp" android:topRightRadius="10dp" />
            <gradient
                android:angle="0"
                android:endColor="#7FAF1F"
                android:startColor="#8BC400"
                android:type="linear" />
            <padding android:bottom="6dp" android:left="6dp" android:right="6dp" android:top="6dp" />
        </shape>
    </item>


    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="10dp" android:bottomRightRadius="10dp" android:radius="10dp" android:topLeftRadius="10dp" android:topRightRadius="10dp" />
            <gradient
                android:angle="0"
                android:endColor="#5A8D16"
                android:startColor="#6BAA1B"
                android:type="linear" />
            <padding android:bottom="6dp" android:left="6dp" android:right="6dp" android:top="6dp" />
        </shape>
    </item>


</selector>
